	bool	isOper(int c)
	{
		return c == '~' || c == '`' || c == '@' || c == '#' || c == '$' || c == '%'
			|| c == '^' || c == '&' || c == '*' || c == '(' || c == ')' || c == '-'
			|| c == '+' || c == '=' || c == '|' || c == '!' || c == '{' || c == '}'
			|| c == '[' || c == ']' || c == ':' || c == ';' || c == ',' || c == '<'
			|| c == '>' || c == '/' || c == '?' || c == '.' || c == '\\';
	}

	bool	isAlpha(int c)
	{
		return c >= 'A' && c <= 'Z' || c >= 'a' && c <= 'z';
	}

	bool	isIdstart(int c)
	{
		return isAlpha(c) || c == '_';
	}
